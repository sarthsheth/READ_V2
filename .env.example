# ==========================================
# Cloud-Synced Personal Reader (READ_V2) Environment
# ==========================================

# Google Cloud Project Configuration
GCP_PROJECT_ID="personal-reader-app"
GCP_REGION="us-central1"
GCS_BUCKET_NAME="my-reader-library-us-central1"

# Google Identity Services / OAuth 2.0 (Testing Mode)
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
ALLOWED_EMAIL="yourname@gmail.com"

# Local Development & Offline Mocking (Set to True if GCP is not yet configured)
DEV_MODE=True
MOCK_GCP=True

# Application Server
PORT=8000
HOST="127.0.0.1"

